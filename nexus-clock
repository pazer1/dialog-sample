#!/usr/bin/env python3
import subprocess
import json
import time
import socket
import datetime
import sys
from urllib.request import Request, urlopen
from urllib.error import URLError

# ================= CONFIGURATION =================
TARGET_URL = "http://nexus.skhynix.com"  # 프로토콜(http/https) 확인 필수
INTERFACE = "bond0"                        # 강제할 인터페이스 이름
CHECK_INTERVAL = 300                       # 체크 주기 (초 단위, 300초 = 5분)
SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/T000/B000/XXXXX" # Webhook URL 입력
HOSTNAME = socket.gethostname()
# =================================================

def send_slack_alert(error_msg, http_code="N/A"):
    """Slack으로 알림을 전송합니다."""
    current_time = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    
    payload = {
        "blocks": [
            {
                "type": "header",
                "text": {
                    "type": "plain_text",
                    "text": "🚨 Nexus Connectivity Alert",
                    "emoji": True
                }
            },
            {
                "type": "section",
                "fields": [
                    {"type": "mrkdwn", "text": f"*Host:*\n{HOSTNAME}"},
                    {"type": "mrkdwn", "text": f"*Interface:*\n{INTERFACE}"},
                    {"type": "mrkdwn", "text": f"*Time:*\n{current_time}"},
                    {"type": "mrkdwn", "text": f"*Status Code:*\n{http_code}"}
                ]
            },
            {
                "type": "section",
                "text": {
                    "type": "mrkdwn",
                    "text": f"*Error Details:*\n```{error_msg}```"
                }
            }
        ]
    }

    req = Request(
        SLACK_WEBHOOK_URL, 
        data=json.dumps(payload).encode('utf-8'), 
        headers={'Content-Type': 'application/json'}
    )
    
    try:
        with urlopen(req) as response:
            print(f"[{current_time}] Slack alert sent successfully.")
    except Exception as e:
        print(f"[{current_time}] Failed to send Slack alert: {e}")

def check_nexus():
    """curl을 사용하여 bond0 인터페이스로 연결을 시도합니다."""
    cmd = [
        "curl",
        "--interface", INTERFACE,  # 핵심: bond0 강제 사용
        "-s",                      # Silent mode
        "-o", "/dev/null",         # 본문 버림
        "-w", "%{http_code}",      # 상태 코드만 출력
        "--connect-timeout", "10", # 10초 타임아웃
        TARGET_URL
    ]

    try:
        # 명령어 실행
        result = subprocess.run(cmd, capture_output=True, text=True)
        http_code = result.stdout.strip()
        
        # 성공 조건: HTTP 200, 301, 302 (필요 시 401 등 추가)
        if http_code in ["200", "301", "302"]:
            print(f"[{datetime.datetime.now()}] Connection OK (Code: {http_code})")
            return True, http_code
        else:
            error_msg = f"Unexpected HTTP Code: {http_code}"
            return False, http_code

    except Exception as e:
        return False, str(e)

def main():
    print(f"Starting Monitor: {TARGET_URL} via {INTERFACE}")
    sys.stdout.flush() # 로그 즉시 기록
    
    while True:
        success, msg = check_nexus()
        
        if not success:
            print(f"[{datetime.datetime.now()}] CRITICAL: {msg}")
            # 실패 시 Slack 전송 (msg 변수에 http_code 혹은 에러메시지가 들어있음)
            # msg가 숫자인지 에러 텍스트인지 판별하여 보냄
            code = msg if msg.isdigit() else "ERR"
            send_slack_alert(f"Connection Failed via {INTERFACE}", code)
        
        time.sleep(CHECK_INTERVAL)

if __name__ == "__main__":
    main()
